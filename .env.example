# ============================================================
# SmartRecruit AI - Variables d'environnement (développement local)
# Copier ce fichier en .env et adapter les valeurs.
# Le fichier .env est ignoré par Git.
# ============================================================

# --- Base de données MariaDB (XAMPP) ---
DB_URL=jdbc:mariadb://localhost:3306/smartrecruit_ai
DB_USERNAME=root
DB_PASSWORD=

# --- JWT ---
# Secret HS256 : minimum 32 caractères, 64+ recommandé.
# REMPLACER IMPÉRATIVEMENT cette valeur de développement avant toute mise en production.
JWT_SECRET=SmartRecruitAI-dev-jwt-secret-key-please-change-me-0123456789-ABCDEF
JWT_EXPIRATION_MS=86400000

# --- Compte administrateur initial (créé uniquement si aucun ADMIN n'existe) ---
ADMIN_EMAIL=admin@smartrecruit.local
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=SmartRecruit

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Microservice interne de recherche sémantique (FastAPI) ---
# La clé reste côté Spring Boot et ne doit jamais être exposée à Angular.
# Elle doit être identique à AI_SERVICE_API_KEY du fichier ai-service/.env.
AI_SERVICE_ENABLED=true
AI_SERVICE_BASE_URL=http://localhost:8001
AI_SERVICE_API_KEY=smartrecruit-local-development-key
AI_SERVICE_TIMEOUT_SECONDS=30
AI_SERVICE_CHAT_TIMEOUT_SECONDS=120
AI_SERVICE_REINDEX_ALL_MAX=100
