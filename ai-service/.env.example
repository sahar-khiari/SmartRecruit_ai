# Service interne SmartRecruit AI - aucune clé ni secret réel dans ce fichier.
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001
AI_SERVICE_API_KEY=smartrecruit-local-development-key

# ChromaDB local persistant
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=hr_knowledge

# Embeddings locaux (aucune API distante)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# Découpage et recherche
CHUNK_SIZE=700
CHUNK_OVERLAP=100
DEFAULT_TOP_K=5
MAX_TOP_K=10
MIN_RELEVANCE_SCORE=0.30

# --- LLM local Ollama (Module 1 - RAG) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=8192

# --- Génération RAG ---
RAG_CHAT_TOP_K=3
RAG_MIN_RELEVANCE_SCORE=0.35
RAG_MAX_CONTEXT_CHARS=12000
LLM_MAX_ANSWER_CHARS=4000
PROMPT_VERSION=hr-rag-v1
LLM_MAX_RETRIES=1

LOG_LEVEL=INFO

# ==================================================
# Module 4 — Tests techniques & Évaluation IA (Aziz)
# ==================================================
LLM_API_KEY=REMPLACE_PAR_TA_CLE_GROQ
LLM_BASE_URL=https://api.groq.com/openai
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=60
DATABASE_URL=

# ==================================================
# Module 2 — IA de gestion des offres (Cohere)
# ==================================================
# Clé d'essai gratuite : https://dashboard.cohere.com/api-keys (ne jamais la committer)
COHERE_API_KEY=REMPLACE_PAR_TA_CLE_COHERE
COHERE_CHAT_MODEL=command-r-08-2024
COHERE_EMBED_MODEL=embed-multilingual-v3.0
COHERE_TIMEOUT_SECONDS=30
COHERE_MAX_RETRIES=2
OFFRES_CACHE_SIZE=128
